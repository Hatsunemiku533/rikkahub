+package me.rerere.rikkahub.data.db.migrations
+
+import me.rerere.ai.ui.UIMessage
+import me.rerere.rikkahub.utils.JsonInstant
+import kotlin.uuid.Uuid
+
+// Migration-only compatibility. No legacy flags or behavior enter the live model.
+internal data class LegacyCompressionNode(
+    val id: String,
+    val messages: String,
+    val selectIndex: Int,
+    val compressed: Boolean = false,
+    val isSummary: Boolean = false,
+)
+
+internal fun convertLegacyCompression(nodes: List<LegacyCompressionNode>): List<LegacyCompressionNode> {
+    if (nodes.none { it.compressed || it.isSummary }) return nodes
+    val summaries = nodes.filter { it.isSummary }.map { node ->
+        val messages = JsonInstant.decodeFromString<List<UIMessage>>(node.messages)
+        requireNotNull(messages.getOrNull(node.selectIndex)) { "Invalid legacy summary branch" }.toText()
+    }
+    val summary = summaries.joinToString("\n\n").trim()
+    check(summary.isNotBlank()) { "Archived history has no usable legacy summary" }
+    val cut = nodes.indexOfLast { it.compressed || it.isSummary }
+    // The old format is summaries + archived originals + retained recent nodes.
+    // Refuse ambiguous interleaving rather than dropping a live message from context.
+    check(nodes.take(cut + 1).all { it.compressed || it.isSummary }) {
+        "Legacy compressed history is interleaved with active messages"
+    }
+    val checkpoint = UIMessage.user(summary).copy(isContextCheckpoint = true)
+    val newNode = LegacyCompressionNode(
+        id = Uuid.random().toString(),
+        messages = JsonInstant.encodeToString(listOf(checkpoint)),
+        selectIndex = 0,
+    )
+    // All original rows remain byte-for-byte intact, including IDs, attachments,
+    // selected branches and old summaries. Only insert an official checkpoint.
+    return nodes.take(cut + 1) + newNode + nodes.drop(cut + 1)
+}
