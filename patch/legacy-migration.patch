@@ -0,0 +1,51 @@
+package me.rerere.rikkahub.data.db.migrations
+
+import me.rerere.ai.ui.UIMessage
+import me.rerere.ai.ui.limitContext
+import me.rerere.rikkahub.utils.JsonInstant
+import org.junit.Assert.*
+import org.junit.Test
+
+class LegacyCompressionTest {
+    private fun node(id: String, text: String, compressed: Boolean = false, summary: Boolean = false) =
+        LegacyCompressionNode(id, JsonInstant.encodeToString(listOf(UIMessage.user(text))), 0, compressed, summary)
+
+    @Test
+    fun `upgrade preserves opaque originals and selected branches while keeping only summary and recent context`() {
+        val summary = node("s", "important decisions", summary = true)
+        val archived = node("a", "old text and attachments", compressed = true).copy(
+            messages = JsonInstant.encodeToString(listOf(UIMessage.user("branch A"), UIMessage.user("branch B"))),
+            selectIndex = 1,
+        )
+        val recent = node("r", "recent exact text")
+        val converted = convertLegacyCompression(listOf(summary, archived, recent))
+        assertEquals(listOf(summary, archived, recent), converted.filter { it.id in setOf("s", "a", "r") })
+        val messages = converted.map { JsonInstant.decodeFromString<List<UIMessage>>(it.messages)[it.selectIndex] }
+        assertEquals(listOf("important decisions", "recent exact text"), messages.limitContext(0).map { it.toText() })
+        assertEquals(1, messages.count { it.isContextCheckpoint })
+    }
+
+    @Test
+    fun `all summary chunks reach the new checkpoint`() {
+        val converted = convertLegacyCompression(listOf(node("s1", "first", summary = true), node("s2", "second", summary = true), node("a", "old", compressed = true)))
+        val checkpoint = JsonInstant.decodeFromString<List<UIMessage>>(converted.last().messages).single()
+        assertTrue(checkpoint.isContextCheckpoint)
+        assertEquals("first\n\nsecond", checkpoint.toText())
+    }
+
+    @Test
+    fun `uncompressed conversation is unchanged`() {
+        val nodes = listOf(node("u", "hi"))
+        assertSame(nodes, convertLegacyCompression(nodes))
+    }
+
+    @Test(expected = IllegalStateException::class)
+    fun `missing summary fails instead of exposing archived messages`() {
+        convertLegacyCompression(listOf(node("a", "old", compressed = true)))
+    }
+
+    @Test(expected = IllegalStateException::class)
+    fun `ambiguous interleaving fails instead of silently dropping active context`() {
+        convertLegacyCompression(listOf(node("s", "summary", summary = true), node("live", "keep"), node("a", "old", compressed = true)))
+    }
+}
diff --git a/app/src/test/java/me/rerere/rikkahub/data/db/migrations/LegacyPatchMigrationTest.kt b/app/src/test/java/me/rerere/rikkahub/data/db/migrations/LegacyPatchMigrationTest.kt
new file mode 100644
index 0000000..65cd5a1
--- /dev/null
+++ b/app/src/test/java/me/rerere/rikkahub/data/db/migrations/LegacyPatchMigrationTest.kt
@@ -0,0 +1,117 @@
+package me.rerere.rikkahub.data.db.migrations
+
+import android.database.Cursor
+import androidx.sqlite.db.SupportSQLiteDatabase
+import kotlinx.serialization.json.*
+import me.rerere.ai.ui.UIMessage
+import me.rerere.rikkahub.utils.JsonInstant
+import org.junit.Assert.*
+import org.junit.Test
+import java.io.File
+import java.lang.reflect.Proxy
+import java.sql.Connection
+import java.sql.DriverManager
+
+/** Executes the real Android migration against SQLite on the JVM. No mocked SQL. */
+class LegacyPatchMigrationTest {
+    private fun schema(version: Int): JsonObject {
+        val root = listOf(File("schemas"), File("app/schemas")).first { it.isDirectory }
+        return JsonInstant.parseToJsonElement(File(root, "me.rerere.rikkahub.data.db.AppDatabase/$version.json").readText())
+            .jsonObject.getValue("database").jsonObject
+    }
+
+    private fun Connection.createSchema(version: Int) {
+        schema(version).getValue("entities").jsonArray.forEach { value ->
+            val entity = value.jsonObject
+            val table = entity.getValue("tableName").jsonPrimitive.content
+            createStatement().use { it.execute(entity.getValue("createSql").jsonPrimitive.content.replace("\${TABLE_NAME}", table)) }
+            entity["indices"]?.jsonArray?.forEach { index ->
+                createStatement().use { it.execute(index.jsonObject.getValue("createSql").jsonPrimitive.content.replace("\${TABLE_NAME}", table)) }
+            }
+        }
+    }
+
+    private fun database(connection: Connection): SupportSQLiteDatabase = Proxy.newProxyInstance(
+        SupportSQLiteDatabase::class.java.classLoader, arrayOf(SupportSQLiteDatabase::class.java),
+    ) { _, method, args ->
+        when (method.name) {
+            "execSQL" -> {
+                connection.prepareStatement(args!![0] as String).use { statement ->
+                    if (args.size > 1) (args[1] as Array<*>).forEachIndexed { i, value -> statement.setObject(i + 1, value) }
+                    statement.execute()
+                }
+                null
+            }
+            "query" -> {
+                val statement = connection.prepareStatement(args!![0] as String)
+                if (args.size > 1 && args[1] is Array<*>) (args[1] as Array<*>).forEachIndexed { i, value -> statement.setObject(i + 1, value) }
+                val result = statement.executeQuery()
+                Proxy.newProxyInstance(Cursor::class.java.classLoader, arrayOf(Cursor::class.java)) { _, cursorMethod, cursorArgs ->
+                    when (cursorMethod.name) {
+                        "moveToNext" -> result.next()
+                        "getString" -> result.getString((cursorArgs!![0] as Int) + 1)
+                        "getInt" -> result.getInt((cursorArgs!![0] as Int) + 1)
+                        "close" -> { result.close(); statement.close(); null }
+                        else -> error("Unexpected cursor method ${cursorMethod.name}")
+                    }
+                }
+            }
+            else -> error("Unexpected database method ${method.name}")
+        }
+    } as SupportSQLiteDatabase
+
+    @Test
+    fun `official and fork schemas converge without losing branches or favorites`() {
+        for (version in 24..26) for (patched in listOf(false, true)) {
+            DriverManager.getConnection("jdbc:sqlite::memory:").use { connection ->
+                connection.createStatement().use { it.execute("PRAGMA foreign_keys=ON") }
+                // Fork 26 is upstream 25 with two added flags, not upstream 26.
+                connection.createSchema(if (patched && version == 26) 25 else version)
+                val db = database(connection)
+                if (patched) {
+                    db.execSQL("ALTER TABLE message_node ADD COLUMN compressed INTEGER NOT NULL DEFAULT 0")
+                    db.execSQL("ALTER TABLE message_node ADD COLUMN is_summary INTEGER NOT NULL DEFAULT 0")
+                    // The early fork 25 also predates the workspace column.
+                    if (version == 25) db.execSQL("ALTER TABLE workspaces DROP COLUMN shell_compatibility_mode")
+                }
+                db.execSQL("INSERT INTO ConversationEntity (id,title,nodes,create_at,update_at) VALUES ('c','test','[]',1,1)")
+                val rows = listOf("s" to listOf(UIMessage.user("summary")), "a" to listOf(UIMessage.user("branch A"), UIMessage.user("branch B")), "r" to listOf(UIMessage.user("recent")))
+                rows.forEachIndexed { i, (id, messages) ->
+                    db.execSQL("INSERT INTO message_node (id,conversation_id,node_index,messages,select_index) VALUES (?, 'c', ?, ?, ?)", arrayOf(id, i, JsonInstant.encodeToString(messages), if (id == "a") 1 else 0))
+                }
+                db.execSQL("INSERT INTO favorites (id,type,ref_key,ref_json,snapshot_json,created_at,updated_at) VALUES ('f','message','a','{}','{}',1,1)")
+                if (patched) {
+                    db.execSQL("UPDATE message_node SET is_summary=1 WHERE id='s'")
+                    db.execSQL("UPDATE message_node SET compressed=1 WHERE id='a'")
+                }
+                if (version <= 24) LegacyPatchMigration_24_25.migrate(db)
+                if (version <= 25) LegacyPatchMigration_25_26.migrate(db)
+                LegacyPatchMigration_26_27.migrate(db)
+                // Compare every table/column/index with official 27 (including media tables absent in fork 26).
+                DriverManager.getConnection("jdbc:sqlite::memory:").use { expected ->
+                    expected.createSchema(27)
+                    schema(27).getValue("entities").jsonArray.forEach { entity ->
+                        val table = entity.jsonObject.getValue("tableName").jsonPrimitive.content
+                        fun columns(c: Connection): List<String> = c.createStatement().use { statement ->
+                            statement.executeQuery("PRAGMA table_info(`$table`)").use { result -> buildList {
+                                while (result.next()) add((1..6).joinToString("|") { result.getString(it) ?: "NULL" })
+                            } }
+                        }
+                        assertEquals("schema $version patched=$patched table=$table", columns(expected), columns(connection))
+                    }
+                }
+                connection.createStatement().use { statement ->
+                    statement.executeQuery("SELECT messages,select_index FROM message_node WHERE id='a'").use { result ->
+                        assertTrue(result.next()); assertEquals(1, result.getInt(2))
+                        assertEquals(rows[1].second, JsonInstant.decodeFromString<List<UIMessage>>(result.getString(1)))
+                    }
+                    statement.executeQuery("SELECT count(*) FROM favorites").use { result -> result.next(); assertEquals(1, result.getInt(1)) }
+                    statement.executeQuery("SELECT count(*) FROM message_node").use { result -> result.next(); assertEquals(if (patched) 4 else 3, result.getInt(1)) }
+                    statement.executeQuery("PRAGMA foreign_key_check").use { result -> assertFalse(result.next()) }
+                }
+                // Running the conditional edge again is harmless once old columns are gone.
+                LegacyPatchMigration_26_27.migrate(db)
+            }
+        }
+    }
+}
