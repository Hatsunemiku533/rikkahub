+package me.rerere.rikkahub.ui.pages.extensions.workspace
+
+/** Stable path identities, with one pending endpoint per directory/pane. */
+internal data class WorkspaceRangeSelection(
+    val paths: Set<String> = emptySet(),
+    val anchor: String? = null,
+) {
+    fun swipe(path: String, orderedPaths: List<String>): WorkspaceRangeSelection {
+        val end = orderedPaths.indexOf(path)
+        if (end < 0) return this
+        val start = anchor?.let(orderedPaths::indexOf) ?: -1
+        return if (start < 0) copy(paths = paths + path, anchor = path)
+        else copy(paths = paths + orderedPaths.subList(minOf(start, end), maxOf(start, end) + 1), anchor = null)
+    }
+
+    fun toggle(path: String): WorkspaceRangeSelection = copy(
+        paths = if (path in paths) paths - path else paths + path,
+        anchor = anchor?.takeUnless { it == path },
+    )
+
+    fun retain(visiblePaths: Set<String>): WorkspaceRangeSelection = copy(
+        paths = paths.intersect(visiblePaths),
+        anchor = anchor?.takeIf { it in visiblePaths },
+    )
+}
+
+internal fun workspaceDisplayPath(path: String): String =
+    if (path.isBlank()) "/workspace" else "/workspace/$path"
+
+internal fun workspaceChildPath(directory: String, name: String): String {
+    require(name.isNotBlank() && name != "." && name != ".." && '/' !in name && '\\' !in name && '\u0000' !in name) {
+        "请输入有效文件名（不能包含 / 或 \\）"
+    }
+    return if (directory.isBlank()) name else "$directory/$name"
+}
