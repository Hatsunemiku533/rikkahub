+@Composable
+internal fun WorkspaceBrowserPathTitle(path: String) {
+    val context = LocalContext.current
+    val fullPath = workspaceDisplayPath(path)
+    var showPath by remember { mutableStateOf(false) }
+    Text(
+        text = if (fullPath.length > 38) "…" + fullPath.takeLast(38) else fullPath,
+        maxLines = 1,
+        overflow = TextOverflow.Ellipsis,
+        style = MaterialTheme.typography.titleSmall,
+        modifier = Modifier.clickable { showPath = true },
+    )
+    if (showPath) AlertDialog(
+        onDismissRequest = { showPath = false },
+        title = { Text("当前目录") },
+        text = { Text(fullPath) },
+        confirmButton = { TextButton(onClick = { copyWorkspacePath(context, fullPath); showPath = false }) { Text("复制路径") } },
+        dismissButton = { TextButton(onClick = { showPath = false }) { Text("关闭") } },
+    )
+}
+
+private fun copyWorkspacePath(context: Context, path: String) {
+    (context.getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager)
+        .setPrimaryClip(ClipData.newPlainText("文件路径", path))
+}
+
+@Composable
+internal fun WorkspaceDualPaneBrowser(
+    browser: WorkspaceFileBrowser,
+    state: WorkspaceBrowserState,
+    isActive: Boolean,
+    exporting: Boolean,
+    onResolveImage: suspend (WorkspaceFileEntry) -> File?,
+    onOpen: (WorkspaceFileEntry) -> Unit,
+    onExport: (WorkspaceFileEntry) -> Unit,
+    onBatchExport: (List<WorkspaceFileEntry>) -> Unit,
+    onShare: (WorkspaceFileEntry) -> Unit,
+) {
+    val context = LocalContext.current
+    var menuTarget by remember { mutableStateOf<Pair<Int, WorkspaceFileEntry>?>(null) }
+    var renameTarget by remember { mutableStateOf<WorkspaceFileEntry?>(null) }
+    var deleteTargets by remember { mutableStateOf<List<WorkspaceFileEntry>?>(null) }
+    val selected = state.current.entries.filter { it.path in state.current.selection.paths }
+
+    BackHandler(enabled = isActive && (state.current.selection.paths.isNotEmpty() || state.current.path.isNotBlank())) {
+        if (state.current.selection.paths.isNotEmpty()) browser.clearSelection() else browser.goUp()
+    }
+
+    Column(Modifier.fillMaxSize()) {
+        if (state.busy) LinearProgressIndicator(Modifier.fillMaxWidth())
+        Row(Modifier.weight(1f).fillMaxWidth()) {
+            state.panes.forEachIndexed { index, pane ->
+                WorkspaceBrowserPaneView(
+                    pane = pane,
+                    index = index,
+                    active = state.active == index,
+                    enabled = !state.busy,
+                    modifier = Modifier.weight(1f).fillMaxHeight(),
+                    browser = browser,
+                    onOpen = onOpen,
+                    onResolveImage = onResolveImage,
+                    onMenu = { menuTarget = index to it },
+                )
+            }
+        }
+        if (selected.isNotEmpty()) {
+            Column(Modifier.fillMaxWidth().background(MaterialTheme.colorScheme.surfaceContainer)) {
+                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+                    TextButton(onClick = { browser.clearSelection() }) { Text("取消 (${selected.size})") }
+                    TextButton(onClick = { browser.selectAll(state.active) }, enabled = !state.busy) { Text("全选") }
+                    TextButton(onClick = { onBatchExport(selected.filterNot { it.isDirectory }) }, enabled = !exporting && selected.any { !it.isDirectory }) { Text("导出") }
+                }
+                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceEvenly) {
+                    TextButton(onClick = { browser.requestTransfer(state.active, selected, false) }, enabled = !state.busy) { Text("复制") }
+                    TextButton(onClick = { browser.requestTransfer(state.active, selected, true) }, enabled = !state.busy) { Text("移动") }
+                    TextButton(onClick = { deleteTargets = selected.toList() }, enabled = !state.busy) { Text("删除") }
+                }
+            }
+        }
+    }
+
+    menuTarget?.let { (index, entry) ->
+        val actions = buildList<Pair<String, () -> Unit>> {
+            add("复制" to { browser.requestTransfer(index, listOf(entry), false) })
+            add("移动" to { browser.requestTransfer(index, listOf(entry), true) })
+            add("删除" to { deleteTargets = listOf(entry) })
+            add("重命名" to { renameTarget = entry })
+            if (!entry.isDirectory) {
+                add("导出" to { onExport(entry) })
+                add("分享" to { onShare(entry) })
+            }
+            add("复制文件地址" to { copyWorkspacePath(context, workspaceDisplayPath(entry.path)) })
+            add("多选" to { browser.toggle(index, entry) })
+        }
+        AlertDialog(
+            onDismissRequest = { menuTarget = null },
+            title = { Text(entry.name) },
+            text = {
+                Column(Modifier.verticalScroll(rememberScrollState())) {
+                    actions.chunked(2).forEach { row ->
+                        Row(Modifier.fillMaxWidth()) {
+                            row.forEach { (label, action) ->
+                                TextButton(
+                                    modifier = Modifier.weight(1f),
+                                    enabled = !state.busy && (label != "导出" || !exporting),
+                                    onClick = { menuTarget = null; action() },
+                                ) { Text(label) }
+                            }
+                            if (row.size == 1) Spacer(Modifier.weight(1f))
+                        }
+                    }
+                }
+            },
+            confirmButton = { TextButton(onClick = { menuTarget = null }) { Text("关闭") } },
+        )
+    }
+
+    renameTarget?.let { entry ->
+        var name by remember(entry.path) { mutableStateOf(entry.name) }
+        val valid = runCatching { workspaceChildPath("", name) }.isSuccess
+        AlertDialog(
+            onDismissRequest = { renameTarget = null },
+            title = { Text("重命名") },
+            text = { OutlinedTextField(value = name, onValueChange = { name = it }, label = { Text("完整文件名（含后缀）") }, isError = !valid, singleLine = true) },
+            confirmButton = { TextButton(enabled = valid && !state.busy, onClick = { browser.rename(entry, name); renameTarget = null }) { Text("确定") } },
+            dismissButton = { TextButton(onClick = { renameTarget = null }) { Text("取消") } },
+        )
+    }
+
+    deleteTargets?.let { entries ->
+        AlertDialog(
+            onDismissRequest = { deleteTargets = null },
+            title = { Text("删除 ${entries.size} 个项目？") },
+            text = { Text(entries.joinToString("\n") { workspaceDisplayPath(it.path) }, modifier = Modifier.verticalScroll(rememberScrollState())) },
+            confirmButton = { TextButton(enabled = !state.busy, onClick = { browser.delete(entries); deleteTargets = null }) { Text("删除", color = MaterialTheme.colorScheme.error) } },
+            dismissButton = { TextButton(onClick = { deleteTargets = null }) { Text("取消") } },
+        )
+    }
+
+    state.confirmation?.let { request ->
+        AlertDialog(
+            onDismissRequest = browser::dismissTransfer,
+            title = { Text("${if (request.move) "移动" else "复制"} ${request.entries.size} 个项目") },
+            text = {
+                Text(
+                    "来源：\n${request.entries.joinToString("\n") { workspaceDisplayPath(it.path) }}\n\n目标目录：\n${workspaceDisplayPath(request.targetDirectory)}",
+                    modifier = Modifier.verticalScroll(rememberScrollState()),
+                )
+            },
+            confirmButton = { TextButton(onClick = browser::confirmTransfer, enabled = !state.busy) { Text("确定") } },
+            dismissButton = { TextButton(onClick = browser::dismissTransfer) { Text("取消") } },
+        )
+    }
+
+    state.conflict?.let { conflict ->
+        var alternateName by remember(conflict.target) { mutableStateOf(conflict.entry.name) }
+        val valid = alternateName != conflict.target.substringAfterLast('/') && runCatching { workspaceChildPath("", alternateName) }.isSuccess
+        AlertDialog(
+            onDismissRequest = { browser.answerConflict(WorkspaceConflictAnswer.Cancel) },
+            title = { Text("目标已存在") },
+            text = {
+                Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                    Text(workspaceDisplayPath(conflict.target))
+                    Text("替换文件夹会替换整个文件夹。")
+                    OutlinedTextField(value = alternateName, onValueChange = { alternateName = it }, label = { Text("另存名称（含后缀）") }, singleLine = true)
+                }
+            },
+            confirmButton = {
+                Row {
+                    TextButton(onClick = { browser.answerConflict(WorkspaceConflictAnswer.Replace) }) { Text("替换") }
+                    TextButton(onClick = { browser.answerConflict(WorkspaceConflictAnswer.Rename(alternateName)) }, enabled = valid) { Text("另存") }
+                }
+            },
+            dismissButton = {
+                Row {
+                    TextButton(onClick = { browser.answerConflict(WorkspaceConflictAnswer.Skip) }) { Text("跳过") }
+                    TextButton(onClick = { browser.answerConflict(WorkspaceConflictAnswer.Cancel) }) { Text("停止") }
+                }
+            },
+        )
+    }
+
+    state.message?.let { message ->
+        AlertDialog(
+            onDismissRequest = browser::dismissMessage,
+            title = { Text("文件操作") },
+            text = { Text(message, modifier = Modifier.verticalScroll(rememberScrollState())) },
+            confirmButton = { TextButton(onClick = browser::dismissMessage) { Text("确定") } },
+        )
+    }
+}
+
+@Composable
+private fun WorkspaceBrowserPaneView(
+    pane: WorkspaceBrowserPane,
+    index: Int,
+    active: Boolean,
+    enabled: Boolean,
+    modifier: Modifier,
+    browser: WorkspaceFileBrowser,
+    onOpen: (WorkspaceFileEntry) -> Unit,
+    onResolveImage: suspend (WorkspaceFileEntry) -> File?,
+    onMenu: (WorkspaceFileEntry) -> Unit,
+) {
+    val border = if (active) MaterialTheme.colorScheme.primary.copy(alpha = 0.45f) else MaterialTheme.colorScheme.outlineVariant
+    Column(
+        modifier.border(1.dp, border).pointerInput(index) {
+            // Observe the first down without consuming it, including taps on empty pane space.
+            awaitEachGesture { awaitFirstDown(requireUnconsumed = false); browser.activate(index) }
+        },
+    ) {
+        Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+            TextButton(onClick = { browser.goUp(index) }, enabled = enabled && pane.path.isNotBlank()) { Text("↑") }
+            Text(if (index == 0) "左侧" else "右侧", style = MaterialTheme.typography.labelSmall)
+        }
+        if (pane.loading) LinearProgressIndicator(Modifier.fillMaxWidth())
+        key(pane.path) {
+            val scroll = rememberLazyListState()
+            LazyColumn(Modifier.fillMaxSize(), state = scroll, contentPadding = PaddingValues(bottom = 8.dp)) {
+                pane.error?.let { error -> item { Text(error, color = MaterialTheme.colorScheme.error, modifier = Modifier.padding(8.dp)) } }
+                if (!pane.loading && pane.entries.isEmpty() && pane.error == null) item { Text("空文件夹", modifier = Modifier.padding(12.dp)) }
+                items(pane.entries, key = { it.path }) { entry ->
+                    WorkspaceBrowserRow(
+                        entry = entry,
+                        selected = entry.path in pane.selection.paths,
+                        anchor = entry.path == pane.selection.anchor,
+                        enabled = enabled,
+                        onResolveImage = { onResolveImage(entry) },
+                        onSwipe = { browser.swipe(index, entry) },
+                        onClick = {
+                            browser.activate(index)
+                            when {
+                                pane.selection.paths.isNotEmpty() -> browser.toggle(index, entry)
+                                entry.isDirectory -> browser.open(index, entry)
+                                else -> onOpen(entry)
+                            }
+                        },
+                        onLongClick = { browser.activate(index); onMenu(entry) },
+                    )
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun WorkspaceBrowserRow(
+    entry: WorkspaceFileEntry,
+    selected: Boolean,
+    anchor: Boolean,
+    enabled: Boolean,
+    onResolveImage: suspend () -> File?,
+    onSwipe: () -> Unit,
+    onClick: () -> Unit,
+    onLongClick: () -> Unit,
+) {
+    val context = LocalContext.current
+    val isImage = !entry.isDirectory && entry.detectFileType() == WorkspaceFileType.IMAGE
+    val imageFile by produceState<File?>(null, entry.path, entry.updatedAt, entry.sizeBytes) {
+        if (isImage) value = try { onResolveImage() }
+        catch (error: CancellationException) { throw error }
+        catch (_: Exception) { null }
+    }
+    val threshold = with(LocalDensity.current) { 40.dp.toPx() }
+    val swipe by rememberUpdatedState(onSwipe)
+    Row(
+        Modifier.fillMaxWidth()
+            .background(if (selected) MaterialTheme.colorScheme.primaryContainer else MaterialTheme.colorScheme.surface)
+            .combinedClickable(enabled = enabled, onClick = onClick, onLongClick = onLongClick, onLongClickLabel = "文件操作")
+            .pointerInput(entry.path, enabled, threshold) {
+                if (enabled) {
+                    var distance = 0f
+                    detectHorizontalDragGestures(
+                        onDragStart = { distance = 0f },
+                        onHorizontalDrag = { change, amount -> change.consume(); distance += amount },
+                        onDragEnd = { if (distance < -threshold) swipe() },
+                        onDragCancel = { distance = 0f },
+                    )
+                }
+            }
+            .padding(horizontal = 8.dp, vertical = 9.dp),
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(6.dp),
+    ) {
+        Box(Modifier.size(28.dp), contentAlignment = Alignment.Center) {
+            Icon(if (entry.isDirectory) HugeIcons.Folder01 else HugeIcons.File02, contentDescription = null, modifier = Modifier.size(24.dp))
+            imageFile?.let { file ->
+                val request = remember(file, entry.updatedAt, entry.sizeBytes) {
+                    ImageRequest.Builder(context).data(file)
+                        .memoryCacheKey("workspace:${file.absolutePath}:${entry.updatedAt}:${entry.sizeBytes}").build()
+                }
+                AsyncImage(request, contentDescription = null, modifier = Modifier.fillMaxSize(), contentScale = ContentScale.Crop)
+            }
+        }
+        Column(Modifier.weight(1f)) {
+            Text(entry.name, maxLines = 2, overflow = TextOverflow.Ellipsis, style = MaterialTheme.typography.bodyMedium)
+            Text(
+                if (anchor) "范围起点" else if (selected) "已选中" else if (entry.isDirectory) "文件夹" else entry.sizeBytes.fileSizeToString(),
+                style = MaterialTheme.typography.labelSmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+            )
+        }
+    }
+}
diff --git a/app/src/main/java/me/rerere/rikkahub/ui/pages/extensions/workspace/WorkspaceFileBrowser.kt b/app/src/main/java/me/rerere/rikkahub/ui/pages/extensions/workspace/WorkspaceFileBrowser.kt
