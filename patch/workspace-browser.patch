+package me.rerere.rikkahub.ui.pages.extensions.workspace
+
+import kotlinx.coroutines.*
+import org.junit.Assert.*
+import org.junit.Test
+import me.rerere.workspace.WorkspaceFileEntry
+import java.io.InputStream
+
+class WorkspaceFileBrowserTest {
+    private fun entry(path: String, directory: Boolean = false) = WorkspaceFileEntry(path, path.substringAfterLast('/'), directory, 0, 0)
+    private class Storage : WorkspaceBrowserStorage {
+        var listing: suspend (String) -> List<WorkspaceFileEntry> = { emptyList() }
+        val existing = mutableSetOf<String>()
+        val transfers = mutableListOf<Pair<String, String>>()
+        override suspend fun list(path: String) = listing(path)
+        override suspend fun exists(path: String) = path in existing
+        override suspend fun transfer(source: String, target: String, move: Boolean, overwrite: Boolean) { transfers += source to target }
+        override suspend fun delete(entry: WorkspaceFileEntry) = true
+        override suspend fun importFile(directory: String, name: String, input: InputStream) {}
+    }
+
+    @Test fun panelNavigationAndSelectionAreIndependent() = runBlocking {
+        val store = Storage().apply { listing = { listOf(entry("A"), entry("B"), entry("C"), entry("D")) } }
+        val scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined)
+        try {
+            val browser = WorkspaceFileBrowser(store, scope)
+            browser.swipe(0, entry("A")); browser.swipe(0, entry("D"))
+            browser.open(1, entry("右目录", true))
+            assertEquals(setOf("A", "B", "C", "D"), browser.state.value.panes[0].selection.paths)
+            assertEquals("", browser.state.value.panes[0].path)
+            assertEquals("右目录", browser.state.value.current.path)
+        } finally { scope.cancel() }
+    }
+
+    @Test fun transferTargetIsFrozenWhileTheConfirmationIsOpen() = runBlocking {
+        val store = Storage()
+        val scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined)
+        try {
+            val browser = WorkspaceFileBrowser(store, scope)
+            browser.open(1, entry("目标", true))
+            browser.requestTransfer(0, listOf(entry("来源/a.md")), false)
+            browser.open(1, entry("别处", true))
+            browser.confirmTransfer()
+            assertEquals(listOf("来源/a.md" to "目标/a.md"), store.transfers)
+        } finally { scope.cancel() }
+    }
+
+    @Test fun conflictSupportsSkipRenameAndReplaceWithoutSilentOverwrite() = runBlocking {
+        val store = Storage().apply { existing += "a.md" }
+        val scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined)
+        try {
+            val browser = WorkspaceFileBrowser(store, scope)
+            browser.requestTransfer(0, listOf(entry("source/a.md")), false); browser.confirmTransfer()
+            assertNotNull(browser.state.value.conflict); assertTrue(store.transfers.isEmpty())
+            browser.answerConflict(WorkspaceConflictAnswer.Skip)
+            assertTrue(store.transfers.isEmpty()); assertFalse(browser.state.value.busy)
+            browser.requestTransfer(0, listOf(entry("source/a.md")), false); browser.confirmTransfer()
+            browser.answerConflict(WorkspaceConflictAnswer.Rename("b.txt"))
+            assertEquals("source/a.md" to "b.txt", store.transfers.single())
+            browser.requestTransfer(0, listOf(entry("source/a.md")), false); browser.confirmTransfer()
+            browser.answerConflict(WorkspaceConflictAnswer.Replace)
+            assertEquals("source/a.md" to "a.md", store.transfers.last())
+        } finally { scope.cancel() }
+    }
+
+    @Test fun lateDirectoryResponseCannotReplaceNewerNavigation() = runBlocking {
+        val oldResult = CompletableDeferred<List<WorkspaceFileEntry>>()
+        val store = Storage().apply {
+            listing = { path ->
+                if (path == "old") withContext(NonCancellable) { oldResult.await() }
+                else listOf(entry("$path/current"))
+            }
+        }
+        val scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined)
+        try {
+            val browser = WorkspaceFileBrowser(store, scope)
+            browser.open(0, entry("old", true)); browser.open(0, entry("new", true))
+            oldResult.complete(listOf(entry("old/stale")))
+            assertEquals("new", browser.state.value.current.path)
+            assertEquals("new/current", browser.state.value.current.entries.single().path)
+        } finally { scope.cancel() }
+    }
+}
