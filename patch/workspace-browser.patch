+    /** File-browser transfers stage copies and keep replaced data until the commit succeeds. */
+    fun transfer(root: File, source: String, target: String, move: Boolean, overwrite: Boolean): WorkspaceFileEntry {
+        val base = root.canonicalFile
+        val src = resolvePath(root, source)
+        val dest = resolvePath(root, target)
+        require(src != base && dest != base) { "Cannot transfer workspace root" }
+        require(src.exists()) { "Source does not exist: $source" }
+        require(src != dest) { "Source and target are the same" }
+        require(!dest.toPath().startsWith(src.toPath())) { "Cannot transfer a directory into itself" }
+        require(!src.toPath().startsWith(dest.toPath())) { "Cannot replace a parent of the source" }
+        require(!dest.exists() || overwrite) { "Target already exists: $target" }
+        val parent = dest.parentFile
+        require(parent.isDirectory) { "Target directory does not exist" }
+        val stage = File(parent, ".rikkahub-transfer-${UUID.randomUUID()}")
+        val backup = File(parent, ".rikkahub-backup-${UUID.randomUUID()}")
+        var committed = false
+        var backedUp = false
+        try {
+            if (!move) {
+                // Files.walk does not follow directory links. Preserve links rather than dereferencing them.
+                Files.walk(src.toPath()).use { paths ->
+                    paths.forEach { item ->
+                        val output = stage.toPath().resolve(src.toPath().relativize(item))
+                        Files.copy(item, output, LinkOption.NOFOLLOW_LINKS)
+                    }
+                }
+            }
+            // Recheck immediately before committing; never silently replace a new destination.
+            if (dest.exists()) {
+                require(overwrite) { "Target already exists: $target" }
+                Files.move(dest.toPath(), backup.toPath())
+                backedUp = true
+            }
+            try {
+                Files.move((if (move) src else stage).toPath(), dest.toPath())
+                committed = true
+            } catch (error: Exception) {
+                if (backedUp) {
+                    try {
+                        Files.move(backup.toPath(), dest.toPath())
+                        backedUp = false
+                    } catch (restore: Exception) {
+                        error.addSuppressed(restore)
+                    }
+                }
+                throw error
+            }
+            return dest.toEntry(root)
+        } finally {
+            if (!move) deleteTransferTree(stage.toPath())
+            // On a failed restore leave the backup recoverable; never erase it in finally.
+            if (committed && backedUp) deleteTransferTree(backup.toPath())
+        }
+    }
+
+    private fun deleteTransferTree(path: Path) {
+        if (!Files.exists(path, LinkOption.NOFOLLOW_LINKS)) return
+        Files.walk(path).use { paths ->
+            paths.sorted(Comparator.reverseOrder()).forEach { Files.delete(it) }
+        }
+    }
+
