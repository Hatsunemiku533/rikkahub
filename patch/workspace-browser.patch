+package me.rerere.workspace
+
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+import java.nio.file.Files
+
+class WorkspaceTransferTest {
+    @get:Rule val temp = TemporaryFolder()
+    private val fs = WorkspaceFileSystem()
+
+    @Test fun copiesDirectoryWithUnicodeNamesAndBinaryBytes() {
+        val root = temp.newFolder()
+        File(root, "来源/子目录").mkdirs()
+        File(root, "目标").mkdir()
+        val bytes = byteArrayOf(0, 1, -1, 42)
+        File(root, "来源/子目录/图.bin").writeBytes(bytes)
+        fs.transfer(root, "来源", "目标/来源", move = false, overwrite = false)
+        assertArrayEquals(bytes, File(root, "目标/来源/子目录/图.bin").readBytes())
+        assertArrayEquals(bytes, File(root, "来源/子目录/图.bin").readBytes())
+        assertFalse(root.walk().any { it.name.startsWith(".rikkahub-") })
+    }
+
+    @Test fun moveAndRenameIncludeTheExtension() {
+        val root = temp.newFolder()
+        File(root, "a.txt").writeText("hello")
+        fs.transfer(root, "a.txt", "资料.md", move = true, overwrite = false)
+        assertFalse(File(root, "a.txt").exists())
+        assertEquals("hello", File(root, "资料.md").readText())
+    }
+
+    @Test fun collisionDoesNotTouchEitherFile() {
+        val root = temp.newFolder()
+        File(root, "a").writeText("source")
+        File(root, "b").writeText("destination")
+        assertThrows(IllegalArgumentException::class.java) { fs.transfer(root, "a", "b", true, false) }
+        assertEquals("source", File(root, "a").readText())
+        assertEquals("destination", File(root, "b").readText())
+    }
+
+    @Test fun explicitReplacementReplacesDirectoryRatherThanMerging() {
+        val root = temp.newFolder()
+        File(root, "a").mkdir(); File(root, "b").mkdir()
+        File(root, "a/new").writeText("new")
+        File(root, "b/old").writeText("old")
+        fs.transfer(root, "a", "b", false, true)
+        assertEquals("new", File(root, "b/new").readText())
+        assertFalse(File(root, "b/old").exists())
+        assertTrue(File(root, "a/new").exists())
+    }
+
+    @Test fun rejectsSamePathRootTraversalAndAncestorTargets() {
+        val root = temp.newFolder()
+        File(root, "a/child").mkdirs()
+        listOf("a" to "a", "a" to "a/child/copy", "a/child" to "a", "a" to "", "" to "other", "a" to "../escape").forEach { (source, target) ->
+            assertThrows(IllegalArgumentException::class.java) { fs.transfer(root, source, target, false, true) }
+        }
+        assertTrue(File(root, "a/child").isDirectory)
+    }
+
+    @Test fun missingTargetParentLeavesSourceIntact() {
+        val root = temp.newFolder()
+        File(root, "a").writeText("source")
+        assertThrows(IllegalArgumentException::class.java) { fs.transfer(root, "a", "missing/a", true, false) }
+        assertEquals("source", File(root, "a").readText())
+    }
+
+    @Test fun nestedLinksArePreservedAndReplacementCleanupDoesNotFollowThem() {
+        val root = temp.newFolder()
+        val outside = temp.newFolder()
+        File(outside, "keep").writeText("untouched")
+        File(root, "a").mkdir(); File(root, "b").mkdir()
+        Files.createSymbolicLink(File(root, "a/link").toPath(), outside.toPath())
+        Files.createSymbolicLink(File(root, "b/old-link").toPath(), outside.toPath())
+        fs.transfer(root, "a", "b", false, true)
+        assertTrue(Files.isSymbolicLink(File(root, "b/link").toPath()))
+        assertEquals(outside.toPath(), Files.readSymbolicLink(File(root, "b/link").toPath()))
+        assertEquals("untouched", File(outside, "keep").readText())
+        // Remove links before TemporaryFolder recursively tears down the fixture.
+        Files.delete(File(root, "a/link").toPath()); Files.delete(File(root, "b/link").toPath())
+    }
+}
