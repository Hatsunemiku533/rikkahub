@@ -0,0 +1,242 @@
+package me.rerere.rikkahub.ui.pages.extensions.workspace
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import me.rerere.rikkahub.data.repository.WorkspaceRepository
+import me.rerere.workspace.WorkspaceFileEntry
+import me.rerere.workspace.WorkspaceStorageArea
+import java.io.InputStream
+
+internal data class WorkspaceBrowserPane(
+    val path: String = "",
+    val entries: List<WorkspaceFileEntry> = emptyList(),
+    val loading: Boolean = false,
+    val error: String? = null,
+    val selection: WorkspaceRangeSelection = WorkspaceRangeSelection(),
+)
+
+internal data class WorkspaceTransferRequest(
+    val entries: List<WorkspaceFileEntry>,
+    val targetDirectory: String,
+    val move: Boolean,
+    val targetName: String? = null,
+)
+
+internal data class WorkspaceBrowserConflict(val entry: WorkspaceFileEntry, val target: String)
+internal sealed interface WorkspaceConflictAnswer {
+    data object Replace : WorkspaceConflictAnswer
+    data object Skip : WorkspaceConflictAnswer
+    data object Cancel : WorkspaceConflictAnswer
+    data class Rename(val name: String) : WorkspaceConflictAnswer
+}
+
+internal data class WorkspaceBrowserState(
+    val panes: List<WorkspaceBrowserPane> = listOf(WorkspaceBrowserPane(), WorkspaceBrowserPane()),
+    val active: Int = 0,
+    val busy: Boolean = false,
+    val confirmation: WorkspaceTransferRequest? = null,
+    val conflict: WorkspaceBrowserConflict? = null,
+    val message: String? = null,
+) {
+    val current: WorkspaceBrowserPane get() = panes[active]
+}
+
+/** Independent browser state: Rootfs continues to use the original detail VM. */
+internal class WorkspaceFileBrowser(
+    private val files: WorkspaceBrowserStorage,
+    private val scope: CoroutineScope,
+) {
+    constructor(id: String, repository: WorkspaceRepository, scope: CoroutineScope) : this(
+        RepositoryBrowserStorage(id, repository), scope,
+    )
+    private val mutableState = MutableStateFlow(WorkspaceBrowserState())
+    val state = mutableState.asStateFlow()
+    private val loads = arrayOfNulls<Job>(2)
+    private val loadVersions = IntArray(2)
+    private var conflictAnswer: CompletableDeferred<WorkspaceConflictAnswer>? = null
+
+    init { refreshBoth() }
+
+    private fun updatePane(index: Int, block: (WorkspaceBrowserPane) -> WorkspaceBrowserPane) {
+        mutableState.update { it.copy(panes = it.panes.mapIndexed { paneIndex, pane -> if (paneIndex == index) block(pane) else pane }) }
+    }
+
+    fun activate(index: Int) { mutableState.update { it.copy(active = index) } }
+    fun refreshActive() = refresh(state.value.active)
+    fun refreshBoth() { refresh(0); refresh(1) }
+
+    private fun refresh(index: Int) {
+        loads[index]?.cancel()
+        val version = ++loadVersions[index]
+        val path = state.value.panes[index].path
+        updatePane(index) { it.copy(loading = true, error = null) }
+        loads[index] = scope.launch {
+            try {
+                val entries = files.list(path)
+                if (version == loadVersions[index]) updatePane(index) {
+                    it.copy(entries = entries, loading = false, selection = it.selection.retain(entries.map { file -> file.path }.toSet()))
+                }
+            } catch (error: CancellationException) { throw error }
+            catch (error: Exception) {
+                if (version == loadVersions[index]) updatePane(index) { it.copy(loading = false, error = error.message) }
+            }
+        }
+    }
+
+    fun open(index: Int, entry: WorkspaceFileEntry) {
+        activate(index)
+        if (!entry.isDirectory) return
+        updatePane(index) { WorkspaceBrowserPane(path = entry.path) }
+        refresh(index)
+    }
+
+    fun goUp(index: Int = state.value.active) {
+        activate(index)
+        val path = state.value.panes[index].path
+        if (path.isBlank()) return
+        updatePane(index) { WorkspaceBrowserPane(path = path.substringBeforeLast('/', "")) }
+        refresh(index)
+    }
+
+    fun swipe(index: Int, entry: WorkspaceFileEntry) {
+        activate(index)
+        updatePane(index) { it.copy(selection = it.selection.swipe(entry.path, it.entries.map { file -> file.path })) }
+    }
+
+    fun toggle(index: Int, entry: WorkspaceFileEntry) {
+        activate(index)
+        updatePane(index) { it.copy(selection = it.selection.toggle(entry.path)) }
+    }
+
+    fun clearSelection(index: Int = state.value.active) = updatePane(index) { it.copy(selection = WorkspaceRangeSelection()) }
+    fun selectAll(index: Int) = updatePane(index) {
+        it.copy(selection = WorkspaceRangeSelection(it.entries.map { file -> file.path }.toSet()))
+    }
+
+    fun dismissMessage() { mutableState.update { it.copy(message = null) } }
+    fun dismissTransfer() { mutableState.update { it.copy(confirmation = null) } }
+
+    fun requestTransfer(index: Int, entries: List<WorkspaceFileEntry>, move: Boolean) {
+        if (state.value.busy || entries.isEmpty()) return
+        activate(index)
+        mutableState.update { it.copy(confirmation = WorkspaceTransferRequest(entries.toList(), it.panes[1 - index].path, move)) }
+    }
+
+    fun answerConflict(answer: WorkspaceConflictAnswer) { conflictAnswer?.complete(answer) }
+
+    fun confirmTransfer() {
+        val request = state.value.confirmation ?: return
+        dismissTransfer()
+        executeTransfer(request)
+    }
+
+    private fun executeTransfer(request: WorkspaceTransferRequest) {
+        mutate {
+            var succeeded = 0
+            var skipped = 0
+            val failures = mutableListOf<String>()
+            for (entry in request.entries) {
+                try {
+                    var target = workspaceChildPath(request.targetDirectory, request.targetName ?: entry.name)
+                    var overwrite = false
+                    var skip = false
+                    while (files.exists(target)) {
+                        val deferred = CompletableDeferred<WorkspaceConflictAnswer>()
+                        conflictAnswer = deferred
+                        mutableState.update { it.copy(conflict = WorkspaceBrowserConflict(entry, target)) }
+                        val answer = try { deferred.await() } finally {
+                            conflictAnswer = null
+                            mutableState.update { it.copy(conflict = null) }
+                        }
+                        when (answer) {
+                            WorkspaceConflictAnswer.Replace -> { overwrite = true; break }
+                            WorkspaceConflictAnswer.Skip -> { skip = true; break }
+                            WorkspaceConflictAnswer.Cancel -> {
+                                mutableState.update { it.copy(message = "操作已停止；已完成 $succeeded 个，跳过 $skipped 个") }
+                                return@mutate
+                            }
+                            is WorkspaceConflictAnswer.Rename -> target = workspaceChildPath(request.targetDirectory, answer.name)
+                        }
+                    }
+                    if (skip) { skipped++; continue }
+                    files.transfer(entry.path, target, request.move, overwrite)
+                    succeeded++
+                } catch (error: CancellationException) { throw error }
+                catch (error: Exception) { failures += "${entry.name}：${error.message}" }
+            }
+            mutableState.update { it.copy(message = buildString {
+                append("${if (request.move) "移动" else "复制"}完成：$succeeded 个；跳过 $skipped 个")
+                if (failures.isNotEmpty()) append("\n" + failures.joinToString("\n"))
+            }) }
+        }
+    }
+
+    fun rename(entry: WorkspaceFileEntry, name: String) {
+        val directory = entry.path.substringBeforeLast('/', "")
+        val target = workspaceChildPath(directory, name)
+        if (target != entry.path) executeTransfer(WorkspaceTransferRequest(listOf(entry), directory, true, name))
+    }
+
+    fun delete(entries: List<WorkspaceFileEntry>) = mutate {
+        val failures = mutableListOf<String>()
+        for (entry in entries) {
+            try {
+                check(files.delete(entry)) { "删除失败或文件已不存在" }
+            } catch (error: CancellationException) { throw error }
+            catch (error: Exception) { failures += "${entry.name}：${error.message}" }
+        }
+        if (failures.isNotEmpty()) mutableState.update { it.copy(message = failures.joinToString("\n")) }
+    }
+
+    fun importFile(input: InputStream, name: String, directory: String) {
+        if (state.value.busy) {
+            input.close()
+            mutableState.update { it.copy(message = "文件操作正在进行，请完成后重新导入") }
+            return
+        }
+        mutate { input.use { files.importFile(directory, name, it) } }
+    }
+
+    private fun mutate(block: suspend () -> Unit) {
+        if (state.value.busy) return
+        mutableState.update { it.copy(busy = true) }
+        scope.launch {
+            try { block() }
+            catch (error: CancellationException) { throw error }
+            catch (error: Exception) { mutableState.update { it.copy(message = error.message ?: "文件操作失败") } }
+            finally {
+                mutableState.update { it.copy(busy = false, conflict = null) }
+                refreshBoth()
+            }
+        }
+    }
+}
+
+internal interface WorkspaceBrowserStorage {
+    suspend fun list(path: String): List<WorkspaceFileEntry>
+    suspend fun exists(path: String): Boolean
+    suspend fun transfer(source: String, target: String, move: Boolean, overwrite: Boolean)
+    suspend fun delete(entry: WorkspaceFileEntry): Boolean
+    suspend fun importFile(directory: String, name: String, input: InputStream)
+}
+
+private class RepositoryBrowserStorage(
+    private val id: String,
+    private val repository: WorkspaceRepository,
+) : WorkspaceBrowserStorage {
+    override suspend fun list(path: String) = repository.listFiles(id, WorkspaceStorageArea.FILES, path)
+    override suspend fun exists(path: String) = repository.fileExists(id, path)
+    override suspend fun transfer(source: String, target: String, move: Boolean, overwrite: Boolean) {
+        repository.transferFile(id, source, target, move, overwrite)
+    }
+    override suspend fun delete(entry: WorkspaceFileEntry) = repository.deleteFile(id, WorkspaceStorageArea.FILES, entry.path, entry.isDirectory)
+    override suspend fun importFile(directory: String, name: String, input: InputStream) {
+        repository.importFile(id, WorkspaceStorageArea.FILES, directory, name, input)
+    }
+}
