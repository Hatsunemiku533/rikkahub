+package me.rerere.rikkahub.ui.pages.extensions.workspace
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class WorkspaceRangeSelectionTest {
+    private val ordered = listOf("A", "B", "C", "D")
+    @Test fun forwardAndReverseSwipesSelectTheEntireRange() {
+        for ((first, last) in listOf("A" to "D", "D" to "A")) {
+            val selection = WorkspaceRangeSelection().swipe(first, ordered).swipe(last, ordered)
+            assertEquals(ordered.toSet(), selection.paths)
+            assertNull(selection.anchor)
+        }
+    }
+    @Test fun nextRangeAddsToExistingSelectionAndTapCanUndoOneItem() {
+        val selection = WorkspaceRangeSelection().swipe("A", ordered).swipe("B", ordered)
+            .swipe("D", ordered).swipe("D", ordered).toggle("B")
+        assertEquals(setOf("A", "D"), selection.paths)
+    }
+    @Test fun refreshDropsMissingAnchorAndPaths() {
+        val selection = WorkspaceRangeSelection().swipe("A", ordered).retain(setOf("B", "C", "D"))
+        assertTrue(selection.paths.isEmpty()); assertNull(selection.anchor)
+        assertEquals(setOf("D"), selection.swipe("D", ordered).paths)
+    }
+    @Test fun pathsAndFullFilenamesAreUnambiguous() {
+        assertEquals("/workspace", workspaceDisplayPath(""))
+        assertEquals("/workspace/ai对话存档", workspaceDisplayPath("ai对话存档"))
+        assertEquals("资料/notes.txt.bak", workspaceChildPath("资料", "notes.txt.bak"))
+        listOf("", " ", ".", "..", "../a", "a/b", "a\\b", "a\u0000b").forEach {
+            assertThrows(IllegalArgumentException::class.java) { workspaceChildPath("", it) }
+        }
+    }
+}
