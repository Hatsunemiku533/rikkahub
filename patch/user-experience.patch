+package me.rerere.rikkahub.ui.pages.chat
+
+import me.rerere.ai.core.MessageRole
+import me.rerere.ai.ui.UIMessage
+import me.rerere.ai.ui.UIMessagePart
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.IOException
+import java.io.Writer
+import java.util.concurrent.CancellationException
+
+class MarkdownExportTest {
+    @Test
+    fun `reasoning option hides reasoning in messages and tool output`() {
+        val output = StringBuilder()
+        writeChatMarkdown(
+            output, "Hidden reasoning", "today",
+            listOf(UIMessage(role = MessageRole.ASSISTANT, parts = listOf(
+                UIMessagePart.Reasoning("private reasoning"),
+                UIMessagePart.Tool("call", "test", "{}", listOf(UIMessagePart.Reasoning("tool reasoning"), UIMessagePart.Text("visible output")))
+            ))),
+            encodeImage = { it.url },
+            includeReasoning = false,
+        )
+        assertFalse(output.contains("private reasoning"))
+        assertFalse(output.contains("tool reasoning"))
+        assertTrue(output.contains("visible output"))
+    }
+    @Test
+    fun `text and multiline reasoning retain order and line breaks`() {
+        val output = StringBuilder()
+        writeChatMarkdown(
+            output, "Test chat", "2026-10-01",
+            listOf(
+                UIMessage.user("Question"),
+                UIMessage(role = MessageRole.ASSISTANT, parts = listOf(
+                    UIMessagePart.Reasoning("First line\n\nSecond line"),
+                    UIMessagePart.Text("Answer")
+                ))
+            ),
+            encodeImage = { error("No image expected") }
+        )
+        val text = output.toString()
+        assertTrue(text.startsWith("# Test chat\n\n*Exported on 2026-10-01*"))
+        assertTrue(text.contains("**User**:\n\nQuestion\n"))
+        assertTrue(text.contains("> First line\n> Second line\n"))
+        assertTrue(text.indexOf("Question") < text.indexOf("Answer"))
+        assertEquals(2, Regex("(?m)^---$").findAll(text).count())
+    }
+
+    @Test
+    fun `image and tool image use the encoder and preserve tool output`() {
+        val output = StringBuilder()
+        val encodedUrls = mutableListOf<String>()
+        writeChatMarkdown(
+            output, "Images", "today",
+            listOf(UIMessage(role = MessageRole.ASSISTANT, parts = listOf(
+                UIMessagePart.Image("file:///one.png"),
+                UIMessagePart.Tool("call-1", "search_web", "{\"query\":\"test\"}", listOf(
+                    UIMessagePart.Text("Tool result"),
+                    UIMessagePart.Image("file:///two.png"),
+                    UIMessagePart.Document("file:///doc.txt", "doc.txt")
+                ))
+            ))),
+            encodeImage = {
+                encodedUrls.add(it.url)
+                "data:image/png;base64,TEST"
+            }
+        )
+        assertEquals(listOf("file:///one.png", "file:///two.png"), encodedUrls)
+        val text = output.toString()
+        assertTrue(text.contains("![Image](data:image/png;base64,TEST)"))
+        assertTrue(text.contains("![Tool Image](data:image/png;base64,TEST)"))
+        assertTrue(text.contains("**Tool**: `search_web`"))
+        assertTrue(text.contains("- Call ID: `call-1`"))
+        assertTrue(text.contains("Tool result"))
+        assertTrue(text.contains("[Document: doc.txt](file:///doc.txt)"))
+        assertFalse(text.contains("(null)"))
+    }
+
+    @Test
+    fun `large transcript writes incrementally before the next image is encoded`() {
+        var written = 0L
+        val writer = object : Writer() {
+            override fun write(buffer: CharArray, offset: Int, length: Int) { written += length }
+            override fun flush() {}
+            override fun close() {}
+        }
+        val imagePayload = "data:image/png;base64," + "A".repeat(100_000)
+        var encoded = 0
+        var lastWritten = 0L
+        val messages = List(64) { index ->
+            UIMessage(role = MessageRole.USER, parts = listOf(UIMessagePart.Image("file:///$index.png")))
+        }
+        writeChatMarkdown(writer, "Large chat", "today", messages, encodeImage = {
+            assertTrue("Previous content must already be written", written > lastWritten)
+            lastWritten = written
+            encoded++
+            imagePayload
+        })
+        assertEquals(64, encoded)
+        assertTrue(written > 6_400_000)
+    }
+
+    @Test(expected = IOException::class)
+    fun `write failures are not swallowed or reported as success`() {
+        val writer = object : Writer() {
+            override fun write(buffer: CharArray, offset: Int, length: Int) { throw IOException("Disk full") }
+            override fun flush() {}
+            override fun close() {}
+        }
+        writeChatMarkdown(writer, "Failure", "today", listOf(UIMessage.user("text")), encodeImage = { it.url })
+    }
+
+    @Test(expected = IllegalStateException::class)
+    fun `unexpected encoder failures propagate to the export caller`() {
+        writeChatMarkdown(
+            StringBuilder(), "Failure", "today",
+            listOf(UIMessage(role = MessageRole.USER, parts = listOf(UIMessagePart.Image("file:///one.png")))),
+            encodeImage = { throw IllegalStateException("Encoder failed") }
+        )
+    }
