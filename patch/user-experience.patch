+package me.rerere.rikkahub.ui.pages.chat
+
+import me.rerere.ai.core.MessageRole
+import me.rerere.ai.ui.UIMessage
+import me.rerere.ai.ui.UIMessagePart
+import me.rerere.rikkahub.utils.JsonInstantPretty
+
+/** Stream the transcript into a writer without reading or embedding image data. */
+internal fun writeChatMarkdown(
+    output: Appendable,
+    title: String,
+    exportedOn: String,
+    messages: List<UIMessage>,
+    checkActive: () -> Unit = {},
+    includeReasoning: Boolean = true,
+) {
+    with(output) {
+        append("# $title\n\n")
+        append("*Exported on $exportedOn*\n\n")
+
+        messages.forEach { message ->
+            checkActive()
+            val role = if (message.role == MessageRole.USER) "**User**" else "**Assistant**"
+            append("$role:\n\n")
+            message.parts.forEach { part ->
+                checkActive()
+                when (part) {
+                    is UIMessagePart.Text -> {
+                        append(part.text)
+                        appendLine()
+                    }
+
+                    is UIMessagePart.Image -> {
+                        append("[Image omitted]")
+                        appendLine()
+                    }
+
+                    is UIMessagePart.Reasoning -> {
+                        if (includeReasoning) part.reasoning.lineSequence()
+                            .filter { it.isNotBlank() }
+                            .forEach {
+                                append("> ")
+                                appendLine(it)
+                            }
+                        appendLine()
+                        appendLine()
+                    }
+
+                    is UIMessagePart.Tool -> {
+                        append("**Tool**: `${part.toolName}`")
+                        appendLine()
+                        if (part.toolCallId.isNotBlank()) {
+                            append("- Call ID: `${part.toolCallId}`")
+                            appendLine()
+                        }
+
+                        append("Input:")
+                        appendLine()
+                        append("```json")
+                        appendLine()
+                        append(JsonInstantPretty.encodeToString(part.inputAsJson()))
+                        appendLine()
+                        append("```")
+                        appendLine()
+
+                        if (part.output.isNotEmpty()) {
+                            append("Output:")
+                            appendLine()
+                            part.output.forEach { outputPart ->
+                                checkActive()
+                                when (outputPart) {
+                                    is UIMessagePart.Text -> {
+                                        append("```text")
+                                        appendLine()
+                                        append(outputPart.text)
+                                        appendLine()
+                                        append("```")
+                                        appendLine()
+                                    }
+
+                                    is UIMessagePart.Reasoning -> {
+                                        if (includeReasoning) outputPart.reasoning.lineSequence()
+                                            .filter { it.isNotBlank() }
+                                            .forEach {
+                                                append("> $it")
+                                                appendLine()
+                                            }
+                                    }
+
+                                    is UIMessagePart.Image -> {
+                                        append("[Tool image omitted]")
+                                        appendLine()
+                                    }
+
+                                    is UIMessagePart.Document -> {
+                                        append("[Document: ${outputPart.fileName}](${outputPart.url})")
+                                        appendLine()
+                                    }
+
+                                    is UIMessagePart.Video -> {
+                                        append("[Video](${outputPart.url})")
+                                        appendLine()
+                                    }
+
+                                    is UIMessagePart.Audio -> {
+                                        append("[Audio](${outputPart.url})")
+                                        appendLine()
+                                    }
+
+                                    else -> {}
+                                }
+                            }
+                        }
+                        appendLine()
+                    }
+
+                    else -> {}
+                }
+            }
+            appendLine()
+            append("---")
+            appendLine()
+        }
+    }
+}
