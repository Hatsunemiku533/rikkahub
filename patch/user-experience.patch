+++ b/app/src/test/java/me/rerere/rikkahub/service/PatchedHistoryTest.kt
@@ -0,0 +1,75 @@
+package me.rerere.rikkahub.service
+
+import me.rerere.ai.ui.UIMessage
+import me.rerere.rikkahub.data.model.Conversation
+import me.rerere.rikkahub.data.model.MessageNode
+import me.rerere.rikkahub.data.model.toMessageNode
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.uuid.Uuid
+
+class PatchedHistoryTest {
+    private fun conversation(nodes: List<MessageNode>) = Conversation.ofId(Uuid.random(), messages = nodes)
+
+    @Test
+    fun `increasing recent window reactivates kept archived nodes without losing branches`() {
+        val old = UIMessage.user("old").toMessageNode().copy(compressed = true)
+        val recent = MessageNode(messages = listOf(UIMessage.user("A"), UIMessage.user("B")), selectIndex = 1, compressed = true)
+        val snapshot = conversation(listOf(old, recent))
+        val result = finishPatchedCompression(snapshot, snapshot, listOf("summary"), listOf(old), listOf(recent))
+        assertEquals(recent.copy(compressed = false), result.messageNodes.last())
+    }
+
+    @Test
+    fun `compression retains recent node identity alternatives and favorites`() {
+        val archived = UIMessage.user("old").toMessageNode()
+        val recent = MessageNode(messages = listOf(UIMessage.user("branch A"), UIMessage.user("branch B")), selectIndex = 1, isFavorite = true)
+        val snapshot = conversation(listOf(archived, recent))
+        val result = finishPatchedCompression(snapshot, snapshot.copy(title = "New title"), listOf("summary"), listOf(archived), listOf(recent))
+        assertEquals(recent, result.messageNodes.last())
+        assertEquals("New title", result.title)
+        assertTrue(result.messageNodes[1].compressed)
+        assertTrue(result.messageNodes[0].isSummary)
+    }
+
+    @Test(expected = IllegalStateException::class)
+    fun `deleting messages while compression awaits cannot resurrect the snapshot`() {
+        val node = UIMessage.user("deleted").toMessageNode()
+        val snapshot = conversation(listOf(node))
+        finishPatchedCompression(snapshot, snapshot.copy(messageNodes = emptyList()), listOf("summary"), listOf(node), emptyList())
+    }
+
+    @Test(expected = IllegalStateException::class)
+    fun `editing a message while compression awaits rejects stale summary`() {
+        val node = UIMessage.user("before").toMessageNode()
+        val snapshot = conversation(listOf(node))
+        finishPatchedCompression(snapshot, snapshot.copy(messageNodes = listOf(UIMessage.user("after").toMessageNode())), listOf("summary"), listOf(node), emptyList())
+    }
+
+    @Test
+    fun `normal generation skips archived nodes when writing back`() {
+        val old = UIMessage.user("old").toMessageNode().copy(compressed = true)
+        val active = UIMessage.user("active").toMessageNode()
+        val reply = UIMessage.user("reply")
+        val result = mergePatchedGeneration(listOf(old, active), listOf(active.currentMessage, reply))
+        assertEquals(old, result[0])
+        assertEquals(active, result[1])
+        assertEquals(reply, result[2].currentMessage)
+    }
+
+    @Test
+    fun `regeneration writes multiple output turns to distinct nodes`() {
+        val archived = UIMessage.user("old").toMessageNode().copy(compressed = true)
+        val input = UIMessage.user("question").toMessageNode()
+        val original = UIMessage.user("old answer").toMessageNode()
+        val tool = UIMessage.user("tool step")
+        val answer = UIMessage.user("new answer")
+        val result = mergePatchedGeneration(listOf(archived, input, original), listOf(input.currentMessage, tool, answer), 0..1)
+        assertEquals(archived, result[0])
+        assertEquals(tool, result[2].currentMessage)
+        assertEquals(2, result[2].messages.size)
+        assertEquals(answer, result[3].currentMessage)
+        assertEquals(result, mergePatchedGeneration(result, listOf(input.currentMessage, tool, answer), 0..1))
+    }
+}
