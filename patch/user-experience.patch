+++ b/app/src/main/java/me/rerere/rikkahub/service/PatchedHistory.kt
@@ -0,0 +1,57 @@
+package me.rerere.rikkahub.service
+
+import me.rerere.ai.ui.UIMessage
+import me.rerere.rikkahub.data.model.Conversation
+import me.rerere.rikkahub.data.model.MessageNode
+import me.rerere.rikkahub.data.model.toMessageNode
+
+/** Incoming generation contains only active nodes; archived nodes must never consume an input slot. */
+internal fun mergePatchedGeneration(
+    nodes: List<MessageNode>,
+    messages: List<UIMessage>,
+    range: ClosedRange<Int>? = null,
+): List<MessageNode> {
+    val result = nodes.toMutableList()
+    val inputIndices = if (range == null) nodes.indices else range.start..range.endInclusive
+    var incoming = 0
+    fun replaceAt(index: Int, message: UIMessage) {
+        val node = result.getOrNull(index)
+        if (node == null) {
+            result.add(message.toMessageNode())
+        } else {
+            val existing = node.messages.indexOfFirst { it.id == message.id }
+            result[index] = if (existing >= 0) {
+                node.copy(messages = node.messages.map { if (it.id == message.id) message else it })
+            } else {
+                node.copy(messages = node.messages + message, selectIndex = node.messages.size)
+            }
+        }
+    }
+    for (index in inputIndices) {
+        if (nodes[index].compressed) continue
+        val message = messages.getOrNull(incoming) ?: break
+        replaceAt(index, message)
+        incoming++
+    }
+    // Regeneration can yield several turns (e.g. tool call + final answer), not several alternatives of one turn.
+    var outputIndex = range?.let { it.endInclusive + 1 } ?: result.size
+    messages.drop(incoming).forEach { message -> replaceAt(outputIndex++, message) }
+    return result
+}
+
+internal fun finishPatchedCompression(
+    snapshot: Conversation,
+    current: Conversation,
+    summaries: List<String>,
+    compressed: List<MessageNode>,
+    kept: List<MessageNode>,
+): Conversation {
+    check(current.messageNodes == snapshot.messageNodes) {
+        "Messages changed during compression. No messages were replaced; please retry."
+    }
+    return current.copy(
+        messageNodes = summaries.map { UIMessage.user(it).toMessageNode().copy(isSummary = true) } +
+            compressed.map { it.copy(compressed = true) } + kept.map { it.copy(compressed = false) },
+        chatSuggestions = emptyList(),
+    )
+}
