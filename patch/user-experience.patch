index 0000000..c470974
--- /dev/null
+++ b/app/src/main/java/me/rerere/rikkahub/data/db/migrations/PatchColumnMigrations.kt
@@ -0,0 +1,39 @@
+package me.rerere.rikkahub.data.db.migrations
+
+import androidx.room.migration.Migration
+import androidx.sqlite.db.SupportSQLiteDatabase
+
+private fun SupportSQLiteDatabase.hasColumn(table: String, column: String): Boolean {
+    val cursor = query("PRAGMA table_info(`$table`)")
+    try {
+        val nameIndex = cursor.getColumnIndex("name")
+        while (cursor.moveToNext()) {
+            if (cursor.getString(nameIndex) == column) return true
+        }
+        return false
+    } finally {
+        cursor.close()
+    }
+}
+
+private fun SupportSQLiteDatabase.addColumnIfMissing(table: String, column: String, spec: String) {
+    if (!hasColumn(table, column)) {
+        execSQL("ALTER TABLE `$table` ADD COLUMN `$column` $spec")
+    }
+}
+
+val PatchMigration_24_25 = object : Migration(24, 25) {
+    override fun migrate(db: SupportSQLiteDatabase) {
+        db.addColumnIfMissing("workspaces", "shell_compatibility_mode", "INTEGER NOT NULL DEFAULT 0")
+        db.addColumnIfMissing("message_node", "compressed", "INTEGER NOT NULL DEFAULT 0")
+        db.addColumnIfMissing("message_node", "is_summary", "INTEGER NOT NULL DEFAULT 0")
+    }
+}
+
+val PatchMigration_25_26 = object : Migration(25, 26) {
+    override fun migrate(db: SupportSQLiteDatabase) {
+        db.addColumnIfMissing("workspaces", "shell_compatibility_mode", "INTEGER NOT NULL DEFAULT 0")
+        db.addColumnIfMissing("message_node", "compressed", "INTEGER NOT NULL DEFAULT 0")
+        db.addColumnIfMissing("message_node", "is_summary", "INTEGER NOT NULL DEFAULT 0")
+    }
+}

